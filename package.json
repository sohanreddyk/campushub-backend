{
  "name": "campushub-backend",
  "version": "1.0.0",
  "description": "CampusHub - multi-tenant campus resource management system (backend)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "dev:tsnode": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest"
  },
  "keywords": [
    "campushub",
    "express",
    "typescript",
    "mongoose"
  ],
  "author": "Sohan Reddy",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "jest": "^30.2.0",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "clearMocks": true
  }
}
